{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.13.0/schema.json",
  "name": "cb6dae114aea98d269e7",
  "position": {
    "x": 979.8984529000658,
    "y": 296.3550564482409,
    "z": 7000,
    "height": 744.0989188220536,
    "width": 920.2604384445374,
    "tabOrder": 7000
  },
  "visual": {
    "visualType": "textbox",
    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "What this data cannot tell you",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "15px",
                      "color": "#002060"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "6px",
                      "color": "#14264b"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "This is synthetic sample data",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "12px",
                      "color": "#14264b"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Attendance is generated, not observed. Each school has its own baseline, and each learner a seeded pattern for the year: most are steady, some dip mid-year, decline gradually or improve. School differences are therefore real features of the fixture, but they are invented, so they show that the report can find a difference, never that a school needs help.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11px",
                      "color": "#5f6b6d"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "5px",
                      "color": "#14264b"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Authorised absence is not separated",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "12px",
                      "color": "#14264b"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "The data records present or absent only. Authorised absences sit inside the absent figure and are never counted as being present.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11px",
                      "color": "#5f6b6d"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "5px",
                      "color": "#14264b"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "No progress measures",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "12px",
                      "color": "#14264b"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Tests are shown as individual sittings. There is no progress, national benchmark or expected-progress comparison, because the data does not record which tests can be compared with which.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11px",
                      "color": "#5f6b6d"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "5px",
                      "color": "#14264b"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "No late or missing percentages",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "12px",
                      "color": "#14264b"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "The school systems flag late and missing work, and those flags are shown as counts. Percentages are not shown because the data holds no extensions or excuses, so any total to divide by would be misleading.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11px",
                      "color": "#5f6b6d"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "5px",
                      "color": "#14264b"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Only the class due date",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "12px",
                      "color": "#14264b"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Extensions given to individual students are not in the data. Because the due date is the only date set work carries, marked work is not narrowed by the month and date slicers: it covers the whole reporting period, while attendance and tests follow the period you chose.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11px",
                      "color": "#5f6b6d"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "5px",
                      "color": "#14264b"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Attendance is per school day",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "12px",
                      "color": "#14264b"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Attendance is taken once per day, not per lesson. Class attendance therefore describes that class list across their whole school day, not who was in that lesson.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11px",
                      "color": "#5f6b6d"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "5px",
                      "color": "#14264b"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Actions are records, not effects",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "12px",
                      "color": "#14264b"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Teachers' check-ins, family contacts, plans, referrals and missing-work follow-ups are shown as they were logged. A before and after comparison describes what was observed after an action; it is not evidence that the action caused it. In the sample data, how often an action is followed by fewer absences is a constructed assumption.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11px",
                      "color": "#5f6b6d"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "5px",
                      "color": "#14264b"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "No online activity",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "12px",
                      "color": "#14264b"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "There is no measure of digital activity or engagement. Recorded work statuses are the only signal about work.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11px",
                      "color": "#5f6b6d"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "5px",
                      "color": "#14264b"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "No pupil background data",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "12px",
                      "color": "#14264b"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "The student table holds a name and an ID only. There is nothing about background, needs or funding, so breakdowns by those groups are not possible.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11px",
                      "color": "#5f6b6d"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "5px",
                      "color": "#14264b"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Map locations are geocoded",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "12px",
                      "color": "#14264b"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Schools are placed on the map from their postal address, so a pin lands at the street, not an exact building. The map needs Azure Maps to be allowed in your Power BI tenant settings.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11px",
                      "color": "#5f6b6d"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "5px",
                      "color": "#14264b"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Marks in this sample are invented, not observed",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "12px",
                      "color": "#14264b"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Marks are built from a learner's own seeded aptitude for a subject and a topic, how demanding the kind of task is, and how severely the department marks. Subjects therefore land between 68% and 78% and a learner's own subjects differ by about 13 percentage points on average, so a weakest subject is a real feature of the fixture. It is still a fixture: the aptitudes were invented by a generator, so a gap here evidences that the report can show a gap, never that a child needs help. Work due after recent absence is more often missing and marked lower. Schools and classes differ for the same invented reason. Read the shape, not the child.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11px",
                      "color": "#5f6b6d"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "5px",
                      "color": "#14264b"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "No curriculum topics or skills",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "12px",
                      "color": "#14264b"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "The school systems record an assignment title and nothing else about what it covers — no topic, unit, skill or standard. The Topic column on the Student review page is read from the title, so it is only as good as the titles. Marks cannot be broken down by skill, and no figure here says which idea a student has not grasped.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11px",
                      "color": "#5f6b6d"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "5px",
                      "color": "#14264b"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Subjects are not a common scale",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "12px",
                      "color": "#14264b"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Each subject marks to its own scheme, so a higher share in one subject than another does not mean the student is better at it. Compare a student against the rest of the class within one subject — that is what Difference from Cohort shows — and not one subject against another.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11px",
                      "color": "#5f6b6d"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "5px",
                      "color": "#14264b"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Not a risk model",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "12px",
                      "color": "#14264b"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Nothing here predicts, scores or labels a student. Every figure describes what was recorded, and the early-warning rules are plain counts with a threshold you choose.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11px",
                      "color": "#5f6b6d"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "5px",
                      "color": "#14264b"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Earlier school years hold less",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "12px",
                      "color": "#14264b"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "The previous school year carries membership, attendance and test history only. Class rosters, coursework and the teacher action log start in the latest year, so those pages show the latest year only. Every page is filtered to the latest school year; change that filter in the Filters pane to look at an earlier one.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11px",
                      "color": "#5f6b6d"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "5px",
                      "color": "#14264b"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Where AI could help, with a person deciding",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "13px",
                      "color": "#002060"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "An optional AI summary can organise the evidence already on a page and suggest questions worth asking - a summary for a class review, prompts for a conversation with a student, a first draft of a school briefing, notes on dates where several classes set work at once, or a description of attendance patterns across schools. Any such summary must quote the figures it used, respect the same filters, and never rank schools, suggest a cause, or make a decision about a child.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11px",
                      "color": "#5f6b6d"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
    }
  }
}