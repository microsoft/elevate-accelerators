      ],
      "general": [
        {
          "properties": {
            "altText": {
              "expr": {
                "Literal": {
                  "Value": "'The share of available marks earned on marked work, grouped by subject, with one bar per school inside each subject. Subjects mark to their own schemes and set very different amounts of work, so only the bars within one subject group can be compared; the Subject slicer narrows the chart to a single subject. How much of the work is marked and how many learners stand behind each bar are in the tooltip, together with the strongest and weakest quarter of learners, so a difference between schools can be read against how complete the marking is and how spread out the learners are. Schools mark to their own schemes, so a difference between bars is a difference in recorded marks and not a ranking.'"
                }
              }
            }
          }
        }
      ]
